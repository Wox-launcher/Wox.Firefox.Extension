{
    "manifest_version": 2,
    "name": "Wox",
    "description": "Extends the web features of Wox for Firefox",
    "version": "1.1.0",
    "browser_action": {
        "default_icon": {
            "48": "icon-48.png",
            "96": "icon-96.png"
        },
        "default_title": "Wox",
        "default_popup": "popup.html"
    },
    "icons": {
        "48": "icon-48.png",
        "96": "icon-96.png"
    },
    "background": {
        "page": "background.html",
        "persistent": true
    },
    "permissions": [
        "storage",
        "tabs",
        "<all_urls>",
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "wox@woxlauncher.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
